# Postgres connection string.
# If you add a database from the Vercel dashboard (Storage tab), Vercel injects
# this for you under one of several names and you don't need to set it by hand.
# The app accepts, in order: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL,
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend for save-the-date and RSVP reminder emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=hello@yourdomain.com

# Public URL of the deployed site, no trailing slash
NEXT_PUBLIC_BASE_URL=https://your-site.vercel.app

# OPTIONAL. Set this and the whole site asks visitors for a password before
# they can see anything — put it on the invitation. Leave it unset (or delete
# the line) and the site is public.
SITE_PASSWORD=

# Long random string. Protects /admin.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-something-long-and-random

# Long random string. Vercel sends this to the cron endpoint.
CRON_SECRET=change-me-too
