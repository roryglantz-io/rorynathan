# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Vercel Blob for photo uploads (Vercel dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Resend for save-the-date and RSVP reminder emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=hello@yourwedding.com

# Public URL of the deployed site, no trailing slash
NEXT_PUBLIC_BASE_URL=https://yourwedding.com

# Long random string. Protects /admin and the guestbook moderation endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-something-long-and-random

# Long random string. Vercel sends this to the cron endpoint.
CRON_SECRET=change-me-too
